HOST=127.0.0.1
PORT=3001
DATABASE_PATH=./data/hub.sqlite
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# mock works without an API key. Change to openai to enable live AI.
AI_MODE=mock
OPENAI_API_KEY=
# Set a model available to the hackathon API account.
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=20000
SEED_DEMO=true
